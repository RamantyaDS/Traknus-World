{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@forklift/*": [
        "sims/Forklif-Simulator/src/*"
      ],
      "@crane/*": [
        "sims/Crane-Simulator/src/*"
      ],
      "@excavator/*": [
        "sims/Excavator-Simulator/src/*"
      ],
      "@tractor/*": [
        "sims/Tractor-Simulator/src/*"
      ],
      "@genset/*": [
        "sims/Genset-Simulator/src/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
